@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #27251F;">Управління ролями</h2>
        <a asp-action="Create" class="btn btn-warning fw-bold" style="background-color: #ffbc0d; border-color: #ffbc0d;">
            <i class="bi bi-plus-circle me-1"></i> Додати роль
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Назва ролі</th>
                        <th class="text-end pe-4">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="2" class="text-center py-4 text-muted">
                                Ролей ще не створено.
                            </td>
                        </tr>
                    }
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td class="align-middle ps-4 fw-bold">@role.Name</td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@role.Id" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити цю роль?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Видалити
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="UserList" class="btn btn-outline-dark">
            <i class="bi bi-people me-1"></i> До списку користувачів
        </a>
    </div>
</div>