@using Microsoft.AspNetCore.Identity
@model RestaurantInfrastructure.ViewModels.ChangeRoleViewModel

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white p-3">
            <h2 class="h4 mb-0">Зміна ролей для @Model.UserEmail</h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @* Приховане поле для передачі ID користувача *@
                <input type="hidden" name="userId" value="@Model.UserId" />

                <div class="form-group mb-4">
                    <p class="text-muted mb-3">Виберіть ролі, які хочете призначити користувачу:</p>

                    @foreach (IdentityRole role in Model.AllRoles)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox"
                                   class="form-check-input"
                                   name="roles"
                                   value="@role.Name"
                                   id="role_@role.Id"
                                   @(Model.UserRoles.Contains(role.Name) ? "checked=\"checked\"" : "") />
                            <label class="form-check-label fw-bold" for="role_@role.Id">
                                @role.Name
                            </label>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold px-4" style="background-color: #ffbc0d; border-color: #ffbc0d;">
                        Зберегти зміни
                    </button>
                    <a asp-action="UserList" class="btn btn-outline-secondary">Скасувати</a>
                </div>
            </form>
        </div>
    </div>
</div>