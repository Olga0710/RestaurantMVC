@model RestDomain.Models.Worker

@{
    ViewData["Title"] = "Створити працівника";
}

<div class="container mt-4">
    <h1>Додати працівника до групи</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Прізвище працівника</label>
                    <select asp-for="EmployeeId" class="form-control" asp-items="ViewBag.EmployeeId">
                        <option value="">-- Оберіть людину зі списку --</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Менеджер</label>
                    <select asp-for="ManagerId" class="form-control" asp-items="ViewBag.ManagerId">
                        <option value="">-- Призначити менеджера --</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Інструктор (Наставник)</label>
                    <select asp-for="InstructorId" class="form-control" asp-items="ViewBag.InstructorId">
                        <option value="">-- Призначити інструктора --</option>
                    </select>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="IsMinor" class="form-check-input" type="checkbox" />
                    <label asp-for="IsMinor" class="form-check-label">Неповнолітній</label>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsCertified" class="form-check-input" type="checkbox" />
                    <label asp-for="IsCertified" class="form-check-label">Має сертифікат</label>
                </div>

                <div class="form-group">
                    <input type="submit" value="Зберегти та додати в групу" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Назад до списку</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}