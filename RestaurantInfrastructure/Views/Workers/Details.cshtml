@model RestDomain.Models.Worker

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="bg-primary p-5 text-center text-white">
                    <div class="display-1 mb-2">👤</div>
                    <h2 class="fw-bold">@Model.Employee?.LastName @Model.Employee?.FirstName</h2>
                    <span class="badge bg-light text-primary rounded-pill px-3">@Model.Employee?.Role</span>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="row mb-4">
                        <div class="col-6 border-end">
                            <p class="text-muted small mb-1">СТАТУС</p>
                            <span class="badge @(Model.IsMinor == true ? "bg-warning text-dark" : "bg-success") rounded-pill">
                                @(Model.IsMinor == true ? "Неповнолітній" : "Повнолітній")
                            </span>
                        </div>
                        <div class="col-6">
                            <p class="text-muted small mb-1">СЕРТИФІКАЦІЯ</p>
                            <span class="badge @(Model.IsCertified == true ? "bg-info" : "bg-secondary") rounded-pill">
                                @(Model.IsCertified == true ? "Є сертифікат" : "Немає")
                            </span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-warning rounded-pill px-4">Редагувати</a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">До списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>