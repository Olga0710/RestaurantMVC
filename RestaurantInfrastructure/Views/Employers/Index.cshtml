@model IEnumerable<RestDomain.Models.Employer>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">Склад команди</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Додати працівника
        </a>
        <a asp-action="Import" class="btn btn-outline-primary">Імпорт з Excel</a>
        <a asp-action="Export" class="btn btn-outline-secondary">Експорт в Excel</a>
    </div>

    @* Форма фільтрації *@
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Пошук</label>
                    <input type="text" name="searchString" class="form-control" value="@ViewData["CurrentFilter"]" placeholder="Прізвище або ім'я..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">З дати</label>
                    <input type="date" name="startDate" class="form-control" value="@ViewData["StartDate"]" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">По дату</label>
                    <input type="date" name="endDate" class="form-control" value="@ViewData["EndDate"]" />
                </div>
                <div class="col-md-3">
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-dark">
                <tr>
                    <th>ПІБ</th>
                    <th>Телефон</th>
                    <th>Роль</th>
                    <th>Ставка</th>
                    <th>Нараховано (період)</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var stats = ((Dictionary<int, (double Hours, decimal Salary)>)ViewBag.Stats)[item.Id];
                    <tr>
                        <td class="fw-bold">@item.LastName @item.FirstName</td>
                        <td>
                            <a href="tel:+38@item.PhoneNumber" class="text-decoration-none">
                                <i class="bi bi-telephone text-success"></i> @item.PhoneNumber
                            </a>
                        </td>
                        <td><span class="badge bg-secondary">@item.Role</span></td>
                        <td>@item.SalaryPerHour грн</td>
                        <td><span class="badge bg-success">@stats.Salary грн</span> (@stats.Hours год)</td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-area="Identity"
                                   asp-page="/Account/Register"
                                   asp-route-employerId="@item.Id"
                                   asp-route-role="@item.Role"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Зареєструвати користувача">
                                    <i class="bi bi-key"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>