@model IEnumerable<RestDomain.Models.Bonuse>

@{
    ViewData["Title"] = "Бонуси";
}

<h1>@ViewData["Title"]</h1>

<p>
    @* Кнопка тепер видима завжди *@
    <a asp-action="Create" class="btn btn-primary">Нарахувати новий бонус</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Сума</th>
            <th>Причина</th>
            <th>Дата</th>
            <th>Працівник</th>
            <th>Хто призначив</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                <td>@Html.DisplayFor(modelItem => item.Reason)</td>
                <td>@item.DataGranted?.ToString("dd.MM.yyyy")</td>

                <td>@(item.Employee?.LastName ?? "Не вказано")</td>
                <td>@(item.Manager?.Employee?.LastName ?? "Адмін")</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Деталі</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редагувати</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>