@model RestDomain.Models.Bonuse

@{
    ViewData["Title"] = "Деталі бонусу";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg border-0">
@* Шапка у стилі McDonald's *@
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Інформація про бонус №@Model.Id</h5>
                    <span class="badge bg-warning text-dark fs-6">Статус: Зараховано</span>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="display-6 fw-bold text-success">@Model.Amount ₴</h2>
                        <p class="text-muted">Сума нарахованої винагороди</p>
                    </div>

                    <div class="row g-4">
@* Блок Працівника *@
                        <div class="col-sm-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <small class="text-muted d-block text-uppercase fw-bold small">Отримувач</small>
                                <div class="fs-5 mt-1">
                                    <i class="bi bi-person-fill text-primary"></i>
                                    @(Model.Employee?.LastName) @(Model.Employee?.FirstName)
                                </div>
                                <small class="text-muted">ID працівника: #@Model.EmployeeId</small>
                            </div>
                        </div>

@* Блок Менеджера *@
                        <div class="col-sm-6">
                            <div class="p-3 border rounded bg-light h-100">
                                <small class="text-muted d-block text-uppercase fw-bold small">Призначив менеджер</small>
                                <div class="fs-5 mt-1">
                                    <i class="bi bi-shield-check text-success"></i>
                                    @(Model.Manager?.Employee?.LastName ?? "Адміністрація")
                                </div>
                                <small class="text-muted">Авторизовано через систему</small>
                            </div>
                        </div>

@* Блок Дати *@
                        <div class="col-12">
                            <div class="p-3 border rounded bg-light">
                                <div class="row align-items-center">
                                    <div class="col-sm-6">
                                        <small class="text-muted d-block text-uppercase fw-bold small">Дата та час операції</small>
                                        <div class="fs-6 mt-1">
                                            <i class="bi bi-calendar3 me-2"></i>
                                            @Model.DataGranted?.ToString("dd MMMM yyyy, HH:mm")
                                        </div>
                                    </div>
                                    <div class="col-sm-6 text-sm-end mt-2 mt-sm-0">
                                        <small class="text-muted d-block text-uppercase fw-bold small">Тип транзакції</small>
                                        <span class="badge rounded-pill bg
