<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - McDonald's Admin Panel</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantInfrastructure.styles.css" asp-append-version="true" />

    <style>
        .navbar {
            transition: all 0.3s ease;
        }

        .dropdown-menu {
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: none;
        }

        .nav-link:hover {
            color: #ffbc0d !important;
        }

        .user-badge {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            border-radius: 50px;
            padding: 5px 15px;
            font-size: 0.9rem;
        }

        .footer {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="color: #ffbc0d;">
                    <i class="bi bi-m-circle-fill me-2"></i>McDonald's
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Головна
                                </a>
                            </li>

                            @* ПУНКТ ДЛЯ ВСІХ: Марія та Ірина бачитимуть тут свої зміни *@
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Shifts" asp-action="Index">
                                    <i class="bi bi-calendar3 me-1 text-primary"></i> Мій графік
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ShiftsTypes" asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i> Довідник змін
                                </a>
                            </li>

                            @* Блок Управління (Тільки для Менеджера) *@
                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="managerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill me-1"></i> Управління
                                    </a>
                                    <ul class="dropdown-menu mt-2" aria-labelledby="managerDropdown">
                                        <li><a class="dropdown-item py-2" asp-controller="Employers" asp-action="Index"><i class="bi bi-people me-2 text-muted"></i>Всі працівники</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Bonuses" asp-action="Index"><i class="bi bi-piggy-bank me-2 text-muted"></i>Нарахувати бонуси</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item py-2 fw-bold text-primary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Статистика</a></li>
                                    </ul>
                                </li>
                            }

                            @* Блок Навчання (Менеджер та Інструктор) *@
                            @if (User.IsInRole("Manager") || User.IsInRole("Instructor"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-success fw-bold" href="#" id="instructorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-mortarboard-fill me-1"></i> Навчання
                                    </a>
                                    <ul class="dropdown-menu mt-2" aria-labelledby="instructorDropdown">
                                        <li><a class="dropdown-item py-2" asp-controller="TrainingProgress" asp-action="Index"><i class="bi bi-check2-square me-2 text-muted"></i>Журнал оцінок</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Workers" asp-action="Index"><i class="bi bi-person-badge me-2 text-muted"></i>Список робітників</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <ul class="navbar-nav align-items-center">
                            @if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold" asp-area="Identity" asp-page="/Account/Register">
                                        <i class="bi bi-person-plus me-1"></i> Реєстрація
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <span class="user-badge shadow-sm me-3">
                                    <i class="bi bi-person-circle text-warning me-1"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="nav-link btn btn-link text-danger border-0">Вийти</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="ms-auto">
                        <a class="btn btn-warning btn-sm px-4 rounded-pill shadow-sm fw-bold" href="/Identity/Account/Login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Увійти
                        </a>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 - <span class="text-primary fw-bold">RestManager</span> - McDonald's Admin Panel
            <span class="ms-3 text-warning"><i class="bi bi-tools"></i> v1.4</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>