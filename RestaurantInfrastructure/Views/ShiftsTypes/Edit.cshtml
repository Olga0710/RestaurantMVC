@model RestDomain.Models.ShiftsType
@{
    ViewData["Title"] = "Редагувати";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-warning py-3">
                    <h5 class="mb-0 fw-bold text-dark">✎ Редагування</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label class="fw-bold mb-2">Код</label>
                            <input asp-for="Name" class="form-control bg-light" readonly />
                        </div>
                        <div class="mb-4">
                            <label class="fw-bold mb-2">Опис</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">Зберегти зміни</button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>