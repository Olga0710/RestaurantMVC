@model RestDomain.Models.ShiftsType

@{ ViewData["Title"] = "Видалення"; }

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-danger shadow">
                <div class="card-body p-5 text-center">
                    <div class="text-danger mb-4">
                        <i class="bi bi-exclamation-octagon-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold">Видалити тип зміни?</h3>
                    <p class="text-muted">Ви впевнені, що хочете видалити код <strong class="text-danger">@Model.Name</strong>? Це може призвести до помилок у звітах!</p>
                    
                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg">Так, видалити назавжди</button>
                            <a asp-action="Index" class="btn btn-light">Ні, повернутися</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>