@model RestDomain.Models.ShiftsType

<div class="container mt-5">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-primary text-white py-3">
            <h3 class="mb-0">✨ Додати новий код зміни</h3>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Абревіатура (напр. SOT)</label>
                    <input asp-for="Name" class="form-control rounded-pill px-3" placeholder="Введіть код..." required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Опис</label>
                    <textarea asp-for="Description" class="form-control rounded-4" rows="3"></textarea>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow">Зберегти</button>
                    <a asp-action="Index" class="btn btn-light rounded-pill">Скасувати</a>
                </div>
            </form>
        </div>
    </div>
</div>