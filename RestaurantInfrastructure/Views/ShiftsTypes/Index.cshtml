@model IEnumerable<RestDomain.Models.ShiftsType>

@functions {
    public string GetBadgeColor(string code)
    {
        string[] colors = { "bg-primary", "bg-success", "bg-danger", "bg-info", "bg-indigo", "bg-teal", "bg-orange", "bg-dark", "bg-maroon", "bg-navy", "bg-cyan" };
        int hash = 0;
        foreach (char c in (code ?? "")) hash = (hash << 5) - hash + c;
        return colors[Math.Abs(hash) % colors.Length] + " text-white";
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="display-5 fw-bold text-primary">📖 Довідник кодів</h1>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">Додати код</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="flip-card">
                    <div class="flip-card-inner">
                        <div class="flip-card-front card border-0 shadow-sm rounded-4">
                            <div class="@GetBadgeColor(item.Name) position-absolute top-0 start-0 end-0" style="height: 6px;"></div>
                            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                                <h2 class="display-6 fw-bold font-monospace">@item.Name</h2>
                            </div>
                        </div>
                        <div class="flip-card-back card border-0 shadow rounded-4 bg-dark text-white">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                                <p class="small">@(item.Description ?? "Опис відсутній")</p>
                                <div class="d-flex gap-2 mt-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning rounded-circle"><i class="bi bi-pencil"></i>✎</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger rounded-circle"><i class="bi bi-trash"></i>✖</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .flip-card {
        background-color: transparent;
        height: 180px;
        perspective: 1000px;
    }

    .flip-card-inner {
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.6s;
        transform-style: preserve-3d;
    }

    .flip-card:hover .flip-card-inner {
        transform: rotateY(180deg);
    }

    .flip-card-front, .flip-card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 1rem;
    }

    .flip-card-back {
        transform: rotateY(180deg);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-indigo {
        background-color: #6610f2;
    }

    .bg-maroon {
        background-color: #d63384;
    }

    .bg-navy {
        background-color: #001f3f;
    }

    .bg-teal {
        background-color: #20c997;
    }

    .bg-orange {
        background-color: #fd7e14;
    }
</style>