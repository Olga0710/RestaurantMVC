@model RestaurantInfrastructure.ViewModels.LoginViewModel

<div class="container mt-5">
    <h2>Вхід у систему McDonald's</h2>
    <hr />

    <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
        @* Виводить загальні помилки, наприклад "Неправильний пароль" *@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Електронна пошта</label>
            <input asp-for="Email" class="form-control" placeholder="Введіть ваш Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Пароль</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Введіть пароль" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Запам'ятати мене?</label>
        </div>

        <div>
            <button type="submit" class="btn btn-primary px-4">Увійти</button>
        </div>
    </form>
</div>