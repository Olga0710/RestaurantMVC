@model IEnumerable<RestDomain.Models.Shift>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">📅 Графік змін</h1>
        <div class="card shadow-sm border-0 mb-4 bg-light">
            <div class="card-body">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small">Працівник</label>
                        <input type="text" name="searchString" class="form-control border-primary-subtle"
                               placeholder="Прізвище..." value="@ViewBag.CurrentFilter" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small">Дата (або початок)</label>
                        <input type="date" name="startDate" class="form-control border-primary-subtle"
                               value="@ViewBag.StartDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small">Кінець періоду (опційно)</label>
                        <input type="date" name="endDate" class="form-control border-primary-subtle"
                               value="@ViewBag.EndDate" />
                    </div>

                    <div class="col-md-3 d-flex gap-1">
                        <button type="submit" class="btn btn-primary flex-grow-1 shadow-sm fw-bold">
                            <i class="bi bi-filter"></i> Знайти
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Скинути">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
        </div>
        @* Кнопка тепер доступна всім *@
        <a asp-action="Create" class="btn btn-warning shadow-sm fw-bold">＋ Створити зміну</a>
    </div>

    <table class="table shadow-sm bg-white rounded overflow-hidden">
        <thead class="table-dark">
            <tr>
                <th>Дата</th>
                <th>Працівник</th>
                <th>Час</th>
                <th>Позиція</th>
                <th class="text-center">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-middle">@item.ShiftDate?.ToString("dd.MM.yyyy")</td>
                    <td class="align-middle fw-bold">@item.Employee?.LastName @item.Employee?.FirstName</td>
                    <td class="align-middle">
                        @* Формат @"hh\:mm" для TimeSpan запобігає помилкам *@
                        <span class="text-success">@item.StartTime?.ToString(@"hh\:mm")</span> —
                        <span class="text-danger">@item.EndTime?.ToString(@"hh\:mm")</span>
                    </td>
                    <td class="align-middle">
                        <span class="badge bg-primary">@item.ShiftType?.Name</span>
                    </td>
                    <td class="text-center align-middle">
                        <div class="btn-group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">інфо</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">ред.</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">видалення</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>