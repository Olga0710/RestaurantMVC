@model RestDomain.Models.Shift
@{
    string GetDescription(string code) => code switch
    {
        "SOT" => "Каса маячок на сервісі",
        "SRU" => "Збирач на сервісі",
        "SPE" => "Презентер на сервісі",
        "TRN" => "Навчання",
        "KIP" => "Ініціатор на кухні",
        "KGR" => "Грильщик",
        _ => "Опис уточнюється"
    };

}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-body">
            <h2 class="card-title text-primary fw-bold">Деталі зміни</h2>
            <hr />
            <dl class="row fs-5">
                <dt class="col-sm-3 text-muted">Працівник:</dt>
                <dd class="col-sm-9 fw-bold">@Model.Employee?.LastName @Model.Employee?.FirstName</dd>

                <dt class="col-sm-3 text-muted">Дата:</dt>
                <dd class="col-sm-9">@Model.ShiftDate?.ToString("D")</dd>

                <dt class="col-sm-3 text-muted">Час роботи:</dt>
                <dd class="col-sm-9 text-primary">
                    @* Використовуємо зворотний слеш перед двокрапкою для TimeSpan *@
                    @Model.StartTime?.ToString(@"hh\:mm") — @Model.EndTime?.ToString(@"hh\:mm")
                </dd>

                <dt class="col-sm-3 text-muted">Позиція:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">@Model.ShiftType?.Name</span>
                    <span class="ms-2 text-secondary small">(@GetDescription(Model.ShiftType?.Name))</span>
                </dd>
            </dl>
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">До списку</a>
            </div>
        </div>
    </div>
</div>