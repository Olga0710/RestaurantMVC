@{
    ViewData["Title"] = "Головна";
}

<div class="container mt-5">
    <div class="row align-items-center">
        @* Текстове привітання *@
        <div class="col-md-6 text-center text-md-start mb-5 mb-md-0">
            <h1 class="display-3 fw-bold mb-3" style="color: #27251F;">
                Ласкаво просимо в <span style="color: #ffbc0d;">McDonald's IT</span>
            </h1>

            @if (!User.Identity.IsAuthenticated)
            {
                <p class="lead mb-4 text-muted">
                    Будь ласка, авторизуйтесь для доступу до керування змінами та перегляду прогресу навчання.
                </p>
                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    @* Виправлено шлях до Identity *@
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-warning btn-lg px-5 shadow-sm fw-bold" style="background-color: #ffbc0d; border-color: #ffbc0d; color: #27251F;">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Увійти в систему
                    </a>
                </div>
            }
            else
            {
                <p class="lead mb-4 text-muted">
                    Ваш персональний портал для керування змінами, відстеження навчання та моніторингу ефективності.
                </p>
                <div class="d-flex flex-column align-items-start">
                    <div class="p-4 bg-light rounded-3 border mb-3 w-100 shadow-sm">
                        <h4 class="mb-1 text-dark">Привіт, @User.Identity.Name! 👋</h4>
                        <p class="mb-0 text-muted">Ви готові до нової зміни сьогодні?</p>
                    </div>

                    @* Кнопка реєстрації НОВОГО робітника (тільки для Менеджера) *@
                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-success btn-md mb-3 fw-bold">
                            <i class="bi bi-person-plus-fill me-2"></i>Зареєструвати нового працівника
                        </a>
                    }

                    @* Кнопка виходу *@
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Вийти з системи
                        </button>
                    </form>
                </div>
            }
        </div>

        @* Картинка *@
        <div class="col-md-6 text-center">
            <div class="position-relative">
                <img src="https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?q=80&w=2071&auto=format&fit=crop"
                     alt="McDonalds"
                     class="img-fluid rounded-4 shadow-lg"
                     style="max-height: 400px; width: 100%; object-fit: cover; border: 5px solid #ffbc0d;">

                <div class="position-absolute bottom-0 start-0 translate-middle-y ms-n3 mb-n3 d-none d-lg-block">
                    <div class="bg-danger rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 80px; height: 80px; border: 4px solid white;">
                        <span class="text-white fw-bold fs-4">24/7</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Нижні картки — показуємо ТІЛЬКИ авторизованим *@
    @if (User.Identity.IsAuthenticated)
    {
        <div class="row mt-5 pt-5 border-top">
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-journal-text display-4 text-primary mb-3"></i>
                        <h5 class="fw-bold">Довідник типів змін</h5>
                        <p class="text-muted small">Дізнайтеся більше про коди позицій (SOT, SPE, NIG тощо).</p>
                        <a asp-controller="ShiftsTypes" asp-action="Index" class="btn btn-link text-decoration-none p-0 fw-bold">Переглянути <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-mortarboard display-4 text-success mb-3"></i>
                        <h5 class="fw-bold">Прогрес навчання</h5>
                        <p class="text-muted small">Слідкуйте за своїм навчання та новими сертифікаціями.</p>
                        <a asp-controller="TrainingProgress" asp-action="Index" class="btn btn-link text-decoration-none p-0 fw-bold">Переглянути <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm text-center p-3">
                    <div class="card-body">
                        <i class="bi bi-calendar3 display-4 text-danger mb-3"></i>
                        <h5 class="fw-bold">Ваш розклад</h5>
                        <p class="text-muted small">Перевірте свої зміни та робочі години на поточний тиждень.</p>
                        <a asp-controller="Shifts" asp-action="Index" class="btn btn-link text-decoration-none p-0 fw-bold text-danger">Перевірити <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>