@model RestDomain.Models.TrainingProgress

<div class="container mt-4">
    <div class="card shadow border-0 mx-auto" style="max-width: 600px;">
        <div class="card-header bg-info text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🔍 Детальний звіт КЛС</h5>
            <span class="badge bg-light text-dark">ID: @Model.Id</span>
        </div>
        <div class="card-body p-4">
            <dl class="row align-items-center">
                <dt class="col-sm-5 text-muted small text-uppercase">Учень:</dt>
                <dd class="col-sm-7 fw-bold fs-5 text-primary">
                    @Model.Worker?.Employee?.LastName @Model.Worker?.Employee?.FirstName
                </dd>

                <dt class="col-sm-5 text-muted small text-uppercase">Станція перевірки:</dt>
                <dd class="col-sm-7 text-dark fw-bold">
                    <i class="bi bi-geo-alt-fill text-danger"></i> @(Model.Station ?? "Не вказана")
                </dd>

                <dt class="col-sm-5 text-muted small text-uppercase">Результат знань:</dt>
                <dd class="col-sm-7">
                    <div class="d-flex align-items-center">
                        <div class="progress flex-grow-1 me-2" style="height: 12px;">
                            @{
                                string colorClass = Model.KnowledgeLevel >= 95 ? "bg-success" :
                                Model.KnowledgeLevel >= 85 ? "bg-info" : "bg-warning";
                            }
                            <div class="progress-bar progress-bar-striped progress-bar-animated @colorClass"
                                 role="progressbar" style="width: @Model.KnowledgeLevel%"></div>
                        </div>
                        <span class="fw-bold">@Model.KnowledgeLevel%</span>
                    </div>
                </dd>

                <dt class="col-sm-5 text-muted small text-uppercase">Інструктор:</dt>
                <dd class="col-sm-7">@Model.InstuctorDNavigation?.Employee?.LastName @Model.InstuctorDNavigation?.Employee?.FirstName</dd>

                <dt class="col-sm-5 text-muted small text-uppercase">Дата перевірки:</dt>
                <dd class="col-sm-7 text-dark">@Model.ReviewDate?.ToString("dd MMMM yyyy") р.</dd>
            </dl>

            <div class="alert alert-secondary mt-3 small">
                <i class="bi bi-info-circle me-2"></i>
                @if (Model.KnowledgeLevel >= 85)
                {
                    <span>Цей результат дозволяє працівнику претендувати на <strong>бонус</strong>.</span>
                }
                else
                {
                    <span>Результат нижче цільового показника (85%). Рекомендується повторне навчання.</span>
                }
            </div>

            <hr />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> До списку
                </a>
                <div class="btn-group">
                    @if (Model.KnowledgeLevel >= 85)
                    {
                        <a asp-action="GrantBonus" asp-route-id="@Model.Id" class="btn btn-success">💰 Бонус</a>
                    }
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">Редагувати</a>
                </div>
            </div>
        </div>
    </div>
</div>